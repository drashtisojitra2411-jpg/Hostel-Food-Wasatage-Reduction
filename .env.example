# Environment Variables for HFWR
# Copy this file to .env.local and fill in your values

# PostgreSQL Database (Neon recommended — free at neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Secret (at least 32 chars — generate one at: https://generate-secret.vercel.app/)
JWT_SECRET=your-jwt-secret-at-least-32-characters

# Frontend API URL (set to your deployed backend URL in production)
# Example: https://api.your-domain.com
VITE_API_URL=

# Backend Port (optional, defaults to 5000)
PORT=5000

# CORS origins (comma-separated)
# Example: http://localhost:5174,https://zerobite-two.vercel.app
CORS_ORIGIN=http://localhost:5174,https://zerobite-two.vercel.app
