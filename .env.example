
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Secret (at least 32 chars — generate one at: https://generate-secret.vercel.app/)
JWT_SECRET=your-jwt-secret-at-least-32-characters

# Frontend API URL (set to your deployed backend URL in production)
# Example: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Backend Port (optional, defaults to 5000)
PORT=5000

CORS_ORIGIN=http://localhost:5174,https://your-vercel-app.vercel.app
 